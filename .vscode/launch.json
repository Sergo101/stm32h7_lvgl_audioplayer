{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Build & Debug Microcontroller - ST-Link",
            "cwd": "${workspaceFolder}",
            "type": "cortex-debug",
            "executable": "${command:cmake.launchTargetPath}",
            "request": "launch",
            "servertype": "stlink",
            "device": "STM32H750IBKx", //MCU used
            "interface": "swd",
            "runToEntryPoint": "main",
            "svdFile": "C:/ST/STM32CubeCLT_1.17.0/STMicroelectronics_CMSIS_SVD/STM32H750.svd",
            "v1": false,               //Change it depending on ST Link version
            "serverArgs": [
                "-m","0",
                "-el ${workspaceFolder}/../CLIVEONE-W25Q128_STM32H7XX-PB2-PB6-PF8-PF9-PF7-PF6.stldr"
            ],
        },
        {
            "name": "Attach to Microcontroller - ST-Link",
            "cwd": "${workspaceFolder}",
            "type": "cortex-debug",
            "executable": "${command:cmake.launchTargetPath}",
            "request": "attach",
            "servertype": "stlink",
            "device": "STM32H750IBKx", //MCU used
            "interface": "swd",
            "serialNumber": "",        //Set ST-Link ID if you use multiple at the same time
            // "runToEntryPoint": "main",
            "svdFile": "C:/ST/STM32CubeCLT_1.17.0/STMicroelectronics_CMSIS_SVD/STM32H750.svd",
            "v1": false,               //Change it depending on ST Link version        
            "serverArgs": [
                "-m","0",
                "-el ${workspaceFolder}/../CLIVEONE-W25Q128_STM32H7XX-PB2-PB6-PF8-PF9-PF7-PF6.stldr"
            ],
        }
            ]
}
